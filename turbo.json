{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": [
				"VITE_TURNSTILE_SITE_KEY",
				"VITE_POSTHOG_PROJECT_TOKEN",
				"VITE_POSTHOG_API_HOST",
				"VITE_POSTHOG_UI_HOST"
			],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".output/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"format": {
			"dependsOn": ["^format"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
