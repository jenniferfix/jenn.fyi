{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"packages/**/*",
			"apps/**/*",
			"**/.vscode/**/*",
			"**/vite.config.js",
			"!.git/**/*",
			"!**/src/routeTree.gen.ts",
			"!**/pnpm-lock.json",
			"!**/node_modules/**/*"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noChildrenProp": "off",
				"useUniqueElementIds": "warn"
			}
		}
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
